<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <PlatformTarget>x64</PlatformTarget><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseUwp>true</UseUwp><UseUwpTools>false</UseUwpTools>
    <SelfContained>true</SelfContained><PublishAot>false</PublishAot><PublishTrimmed>false</PublishTrimmed>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable><StartupObject>UwpProgram</StartupObject><NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <ProjectReference Include="../../../src/ScottPlot5/ScottPlot5/ScottPlot.csproj" />
  </ItemGroup>
</Project>

